{
  "name": "guzellik-salonu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "npm run build && wrangler pages dev --port 8788",
    "db:local": "wrangler d1 migrations apply guzellik-salonu --local",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "seed": "tsx scripts/seed.ts",
    "test:server": "bun test ./test/"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
